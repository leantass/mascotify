generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FAMILY
  PROFESSIONAL
  ADMIN
}

enum ClipStatus {
  ACTIVE
  HIDDEN
  REPORTED
  DELETED
}

enum QrPetStatus {
  NORMAL
  LOST
  FOUND
}

enum QrLocationSource {
  DEVICE_GEOLOCATION
  MANUAL
  UNKNOWN
}

enum QrScanStatus {
  PENDING
  REVIEWED
  RESOLVED
}

model User {
  id          String        @id @default(cuid())
  email       String        @unique
  displayName String
  role        UserRole      @default(FAMILY)
  profiles    UserProfile[]
  clips       Clip[]        @relation("ClipAuthor")
  clipLikes   ClipLike[]
  following   UserFollow[]  @relation("UserFollowing")
  followers   UserFollow[]  @relation("UserFollowers")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@index([role])
  @@index([deletedAt])
}

model UserProfile {
  id          String   @id @default(cuid())
  userId      String
  profileType UserRole
  city        String?
  phone       String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, profileType])
  @@index([profileType])
}

model Clip {
  id              String     @id @default(cuid())
  authorId        String
  title           String
  description     String
  animalType      String
  category        String
  videoUrl        String
  thumbnailUrl    String?
  cloudinaryPublicId String?
  durationSeconds Int?
  likesCount      Int        @default(0)
  commentsCount   Int        @default(0)
  sharesCount     Int        @default(0)
  status          ClipStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  author User       @relation("ClipAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  likes  ClipLike[]

  @@index([authorId])
  @@index([status, createdAt])
}

model ClipLike {
  id        String   @id @default(cuid())
  clipId    String
  userId    String
  createdAt DateTime @default(now())

  clip Clip @relation(fields: [clipId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clipId, userId])
  @@index([userId])
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model QrRegisteredPet {
  id          String      @id @default(cuid())
  qrId        String      @unique
  petId       String
  ownerUserId String
  publicName  String
  species     String
  breed       String?
  color       String?
  publicNotes String?
  status      QrPetStatus @default(NORMAL)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  scans QrScanEvent[]

  @@index([ownerUserId])
  @@index([petId])
  @@index([status])
}

model QrScanEvent {
  id              String           @id @default(cuid())
  qrId            String
  registeredPetId String
  ownerUserId     String
  scannedAt       DateTime         @default(now())
  locationSource  QrLocationSource @default(UNKNOWN)
  latitude        Float?
  longitude       Float?
  accuracyMeters  Float?
  country         String?
  region          String?
  city            String?
  area            String?
  message         String?
  scannerContact  String?
  safetyFlag      Boolean          @default(false)
  readAt          DateTime?
  status          QrScanStatus     @default(PENDING)
  fingerprint     String

  registeredPet QrRegisteredPet @relation(fields: [registeredPetId], references: [id], onDelete: Cascade)

  @@index([qrId, scannedAt])
  @@index([ownerUserId, scannedAt])
  @@index([ownerUserId, readAt])
}
