{
  "name": "mascotify-public-website",
  "private": true,
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./assets/css/input.css -o ./assets/css/styles.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./assets/css/input.css -o ./assets/css/styles.css --watch",
    "serve": "php -S localhost:8088 router.php"
  },
  "devDependencies": {
    "@tailwindcss/cli": "latest",
    "tailwindcss": "latest"
  }
}
