Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
</IfModule>

RewriteEngine On

RewriteRule ^(?:config|includes|storage|_legacy_static_reference)(?:/|$) - [F,L,NC]

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^localhost(?::[0-9]+)?$ [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(?::[0-9]+)?$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

RewriteRule ^index\.html$ / [R=301,L,NC]
RewriteRule ^privacidad\.html$ /privacidad [R=301,L,NC]
RewriteRule ^terminos\.html$ /terminos [R=301,L,NC]
RewriteRule ^eliminacion-de-cuenta\.html$ /eliminacion-de-cuenta [R=301,L,NC]
RewriteRule ^soporte\.html$ /soporte [R=301,L,NC]
RewriteRule ^legal\.html$ /legal [R=301,L,NC]

RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[\s?]|$) [NC]
RewriteRule ^ %1 [R=301,L]

RewriteRule ^(privacidad|terminos|legal|soporte|eliminacion-de-cuenta)/$ /$1 [R=301,L,NC]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteRule ^$ index.php [L]
RewriteRule ^privacidad$ privacidad.php [L]
RewriteRule ^terminos$ terminos.php [L]
RewriteRule ^eliminacion-de-cuenta$ eliminacion-de-cuenta.php [L]
RewriteRule ^soporte$ soporte.php [L]
RewriteRule ^legal$ legal.php [L]
